split_percentage_columns <- function(df, cols) {
for (col in cols) {
if (col %in% names(df)) {
raw_vals <- as.character(df[[col]])
count_vals <- suppressWarnings(
as.numeric(sub("^\\s*(\\d+(?:\\.\\d+)?)\\s*\\((\\d+(?:\\.\\d+)?)%\\)\\s*$", "\\1", raw_vals, perl = TRUE))
